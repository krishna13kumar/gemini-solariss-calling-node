# Environment Mode (development | production)
NODE_ENV=development

# --- Plugin Selection (swap providers without touching code) ---
# LLM_PROVIDER: the startup default — gemini | nvidia | ollama. Every provider whose key is present
# also shows in the dashboard's "AI model" dropdown (switch live) and is used as a fallback if the
# chosen one errors before replying (set LLM_FALLBACK=false to disable).
#   gemini: GEMINI_API_KEY + GEMINI_MODEL     nvidia: NVIDIA_API_KEY (+ NVIDIA_MODEL, optional)
LLM_PROVIDER=gemini
LLM_FALLBACK=true
# Quick-answer embeddings are chosen separately (re-indexes the Q&A when changed): nvidia | gemini
EMBEDDING_PROVIDER=nvidia
# TELEPHONY_PROVIDER: exotel (add new providers in src/providers/index.js)
TELEPHONY_PROVIDER=exotel
# VOICE_PROVIDER: sarvam (add new providers in src/providers/index.js)
VOICE_PROVIDER=sarvam

# false = local test mode (dial-exotel / trigger-campaign become no-ops; use the
# dashboard's "Speak Greeting Now" browser-mic bridge instead). true = real calls.
ENABLE_EXOTEL_CALLS=false

# Server Port
PORT=8000

# Password for the admin dashboard at /admin (leads, results, settings...). Pick a long one.
# Leave it empty and the dashboard stays locked. The public page needs no password.
ADMIN_PASSWORD=
# Cost guards for the public "Speak with agent" page
MAX_CONCURRENT_CALLS=10
MAX_CALL_MINUTES=15

# Target Dialing Number (Exotel Trial Whitelisted Number)
EXOTEL_WHITELISTED_NUMBER=9087439997
CALLER_PHONE_NUMBER=9087439997

# Exotel Cloud Telephony Configuration
# Get these from https://my.exotel.com -> API & Webhooks -> API Details
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
# Your assigned 10-digit Exophone virtual number (e.g. 0804719xxxx or 044xxxxxxxx)
EXOTEL_CALLER_ID=your_exophone_number
# Subdomain: api.exotel.com (or api.in.exotel.com)
EXOTEL_SUBDOMAIN=api.exotel.com
# REQUIRED for real calls. Exotel's Connect API can only route to an App Bazaar
# flow (never a raw external URL) — this flow must contain a Voicebot/AgentStream
# applet node whose websocket URL is kept in sync with your current tunnel domain:
# wss://<APP_PUBLIC_DOMAIN>/ws/audio-stream
EXOTEL_APPLET_ID=

# Public Domain for Webhooks & Audio Stream (e.g. ngrok or cloud domain)
APP_PUBLIC_DOMAIN=your_tunnel.ngrok-free.app

# Sarvam AI Credentials (multilingual STT & TTS; Tamil is the agent's default language)
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
# ta-IN (default) | en-IN | hi-IN | ... — the agent switches to match the customer regardless
VOICE_LANGUAGE_CODE=ta-IN
# Built-in speaker name, or a cloned voice_id (svc-...) from the dashboard's Voice Cloning card
VOICE_SPEAKER=kavya
VOICE_PACE=1.0
# Optional voice tuning:
#   SARVAM_STT_MODE=codemix   (default; English words stay Latin, numbers as digits. 'transcribe' = all Tamil script)
#   VOICE_TEMPERATURE=0.6     (bulbul:v3 only; lower = steadier delivery)

# Voice Activity Detection tuning (raise VAD_ENERGY_THRESHOLD in a noisy room to
# ignore background chatter/TV; raise VAD_MIN_SPEECH_FRAMES to require longer
# sustained speech before a burst counts as a real turn, filtering brief blips)
VAD_ENERGY_THRESHOLD=450
VAD_MIN_SPEECH_FRAMES=3
# Each frame is ~128ms; 4 = ~512ms of silence ends a turn. Lower = faster replies
# but real risk of truncating short/hesitant answers mid-word (which Sarvam STT
# then mis-transcribes as nonsense) — raise further if that still happens.
VAD_SILENCE_FRAMES=4

# Google Gemini AI Configuration (Dialogue & Post-Call CRM Audit)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Ollama Configuration (Optional offline fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Optional: self-hosted STT (Cactus + Whisper) instead of Sarvam's. Falls back to Sarvam if it fails. ---
# STT_PROVIDER=cactus
# CACTUS_STT_URL=http://127.0.0.1:8080/v1/audio/transcriptions
# CACTUS_STT_MODEL=openai/whisper-small
# CACTUS_STT_LANGUAGE=ta
# CACTUS_STT_TIMEOUT_MS=6000
